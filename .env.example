# Google Sign-In Credentials (from Google Cloud Console)
# Obtain these from: https://console.cloud.google.com/
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# Environment definition (development, staging, production)
EXPO_PUBLIC_ENV=development
